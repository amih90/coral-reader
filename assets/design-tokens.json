    "zinc400": "#A1A1AA",
    "bgTop": "#221214",
    "bgMid": "#120C0D",
    "bgBottom": "#09090B",
    "violetMastered": "#8B5CF6",
    "violetMasteredDark": "#A78BFA",
    "greenSuccess": "#16A34A",
    "greenSuccessDark": "#4ADE80",
    "amberWarn": "#D97706",
    "amberWarnDark": "#FBBF24",
    "sky": "#38BDF8",
    "pink": "#F472B6"
