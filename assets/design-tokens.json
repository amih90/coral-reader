  "gradient": {
    "headline": "linear-gradient(90deg, #FF6F61 0%, #FFB3A7 100%)",
    "ctaChip": "linear-gradient(135deg, #FF6F61 0%, #E8544E 100%)",
    "cardGlow": "linear-gradient(160deg, #FF6F61 0%, #D4443E 100%)",
    "background": [
      "radial-gradient(70% 55% at 85% 8%, rgba(255,111,97,.42) 0%, rgba(255,111,97,0) 60%)",
      "radial-gradient(60% 45% at 8% 92%, rgba(232,84,78,.30) 0%, rgba(232,84,78,0) 60%)",
      "radial-gradient(40% 30% at 50% 50%, rgba(246,241,232,.06) 0%, rgba(246,241,232,0) 70%)",
      "linear-gradient(165deg, #221214 0%, #120C0D 48%, #09090B 100%)"
    ],
    "backgroundDots": "radial-gradient(rgba(255,255,255,.08) 1px, transparent 1px) 26px 26px, opacity .5"
  },
  "font": {
    "display": "Plus Jakarta Sans 700, letter-spacing -0.03em, line-height 1.02",
    "body": "Plus Jakarta Sans 500, color rgba(246,241,232,.78)",
    "eyebrow": "Plus Jakarta Sans 700, 22px, letter-spacing .16em, uppercase, color coral500",
