  },
  "radius": {
    "chip": 999,
    "card": 24,
    "capture": 54,
    "cover": 12
  },
  "shadow": {
    "chip": "0 20px 44px rgba(0,0,0,.40)",
    "cover": "0 30px 60px rgba(0,0,0,.55), 0 0 0 1px rgba(255,255,255,.14)",
    "capture": "drop-shadow(0 60px 90px rgba(0,0,0,.55))"
